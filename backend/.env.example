# ---- Aplicacao -------------------------------------------------------------
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- Banco -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://bbbc:bbbc@localhost:5432/bbbc

# ---- Notificacoes ----------------------------------------------------------
# Push no celular nao precisa de nada aqui: o app registra o aparelho sozinho.
# E-mail precisa de um servidor SMTP. Com Gmail, use uma "senha de app"
# (Conta Google > Seguranca > Senhas de app), nunca a sua senha de verdade.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- Open Finance ----------------------------------------------------------
# provider: pluggy | belvo | none
OPEN_FINANCE_PROVIDER=none
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox
BELVO_WEBHOOK_SECRET=
